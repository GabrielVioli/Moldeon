APP_NAME="Moldeon API"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=moldeon
DB_USERNAME=moldeon
DB_PASSWORD=moldeon_dev_password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=moldeon
AWS_SECRET_ACCESS_KEY=moldeon_dev_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=moldeon
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
