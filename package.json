{
  "name": "moldeon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run wasm:build:dev && npm run dev --workspace @moldeon/web",
    "dev:fallback": "npm run dev:fallback --workspace @moldeon/web",
    "build": "npm run build --workspace @moldeon/web",
    "build:wasm": "npm run wasm:build && npm run build:wasm --workspace @moldeon/web",
    "build:web": "npm run build --workspace @moldeon/web",
    "wasm:build": "node scripts/build-wasm.mjs --release",
    "wasm:build:dev": "node scripts/build-wasm.mjs --dev",
    "typecheck": "npm run typecheck --workspace @moldeon/web",
    "test": "npm run test --workspace @moldeon/web",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
